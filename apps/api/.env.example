# ==================================================================================================
# File:        ./apps/api/.env
# Author:      BO$ Kacper
# Created:     2025-12-11
# Updated:     2026-02-03
# Version:     1.0.0
# Mode:        dev
# Description: Environment variables for the hss API service
# License:     AGPL-3.0-only
# Notes:
#   - This file is intended for LOCAL DEVELOPMENT.
#   - Do NOT use weak secrets in production!!!                                               <<< [!]
# ==================================================================================================

# ===[APP]==========================================================================================
NODE_ENV=development
APP_NAME=hss-api
APP_HOST=0.0.0.0
APP_PORT=5000
APP_URL=https://api.hss.local
CORS_ORIGINS=https://hss.local
DATABASE_URL="postgresql://hss:rootsecret@localhost:5432/hss?schema=public"                # <<< [!]

# ===[BETTER AUTH | BFF]============================================================================
BETTER_AUTH_SECRET="CHANGE_ME_GENERATE_A_NEW_AUTH_SECRET"                                 # <<< [!]
BETTER_AUTH_URL=https://hss.local
HSS_BFF_INTERNAL_SECRET="CHANGE_ME_GENERATE_A_SEPARATE_BFF_SECRET"                        # <<< [!]
AUTH_KEYCLOAK_ID=hss-web
AUTH_KEYCLOAK_SECRET="CHANGE_ME_USE_KEYCLOAK_HSS_WEB_CLIENT_SECRET"                       # <<< [!]

# ===[REDIS | AUTH SESSION STORE]===================================================================
HSS_REDIS_URL="redis://nextbff:nextbffsecret@localhost:6379"
HSS_REDIS_CONNECT_TIMEOUT_MS=2000
HSS_REDIS_COMMAND_TIMEOUT_MS=3000
HSS_SESSION_COOKIE_NAME=hss.sid
HSS_SESSION_KEY_PREFIX=hss:sess:
HSS_SESSION_IDLE_TIMEOUT_SECONDS=900
HSS_SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
HSS_SESSION_TOUCH_THROTTLE_SECONDS=60
HSS_SESSION_MAX_EXTENSION_SECONDS=7200
HSS_SESSION_REFRESH_LOCK_TTL_MS=10000

# ===[KEYCLOAK | REALM / ISSUER]====================================================================
KEYCLOAK_REALM=hss
KEYCLOAK_ISSUER=https://auth.hss.local/realms/hss
KEYCLOAK_JWKS_URL=https://auth.hss.local/realms/hss/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=hss-api

# ===[KEYCLOAK | CLIENT (M2M OPTIONAL)]============================================================
KEYCLOAK_API_CLIENT_ID=hss-api
KEYCLOAK_API_CLIENT_SECRET="CHANGE_ME_USE_KEYCLOAK_HSS_API_CLIENT_SECRET"                  # <<< [!]
KEYCLOAK_TOKEN_URL=https://auth.hss.local/realms/hss/protocol/openid-connect/token

# ===[STORAGE | MINIO / S3]===========================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=rootsecret                                                             # <<< [!]
MINIO_REGION=eu-central-1
MINIO_BUCKET=hss
MINIO_BUCKET_NAME=hss
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=s3.hss.local

# ===[SECURITY / RUNTIME]===========================================================================
TRUST_PROXY=true

# ===[EOF @file: apps/api/.env]=====================================================================
